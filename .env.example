# Backend
JWT_SECRET=change-me-in-production
DATABASE_URL=sqlite:///./app.db

# Public URL Label Studio uses to load uploaded images (same machine)
PUBLIC_BASE_URL=http://localhost:8000

# Label Studio (run separately: label-studio start)
LABEL_STUDIO_URL=http://localhost:8080
# Legacy Token (Account & Settings → Legacy Token) — recommended, long-lived
# OR Personal Access Token (JWT starting with eyJ...) — backend refreshes to Bearer
LABEL_STUDIO_API_TOKEN=
